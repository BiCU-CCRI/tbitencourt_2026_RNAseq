# Containers
envs/*.sif

# Raw sequencing reads (download from GEO — see NGS_CaKp/README.md)
NGS_CaKp/*.fq.gz
NGS_CaKp/*.fastq.gz

# Snakemake workflow outputs
.snakemake/
results/
logs/

# Reference data — see reference/README.md.
# Included in the repository: 1. the downloaded NCBI genome/annotation files used for the published analysis (gzipped) and their metadata (reference_metadata/) 2. annotation files for the downstream R analysis, to allow reproducing this analysis from salmon quantification files. 
# Not included: Everything else generated by 01_build_reference.sh — the per-organism and combined FASTA/GTF/GFF, decoys.txt, the STAR and salmon indexes, and build logs.
reference/*.fna
reference/*.gtf
reference/*.gff
reference/*.gaf
reference/decoys.txt
reference/salmon_index_log.txt
reference/salmon_index_output_log.txt
reference/star_index_log.txt
reference/STAR_index_149bp/
reference/salmon_index/

# R / RStudio  (renv's own renv/.gitignore covers renv/library, staging, etc.)
.Rproj.user/
.Rhistory
.RData
candida_klebsiella_diff_expression_analysis/*_cache/
candida_klebsiella_diff_expression_analysis/*_files/
candida_klebsiella_diff_expression_analysis/figures/

# Rmarkdown analysis outputs: ignore everything written to experiment result subdirectories (pathview PNGs, heatmap/volcano/PCA PDFs, xlsx tables, gene lists, provenance, KEGG xml/png). # Note: The knitted html report is written next to the Rmd at the top level of this directory and is not matched here.
candida_klebsiella_diff_expression_analysis/candida_klebsiella_rnaseq_analysis_results*/

# RStudio Server launcher scratch
.rstudio_server/

# The container mounts the repo as $HOME, so RStudio / R writes these into the repo root
.local/
.config/
.cache/
.java/
.rstudio/
R/

# OS / editor
.DS_Store
*.swp
*.log
!reference/reference_metadata/**/*.log

# SLURM job logs
*.out
*.err
